<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.jetbrains.plugins.template</id>
    <name>Pymatic AskSage</name>
    <vendor>BigBear.ai</vendor>
    <description><![CDATA[
        <p><b>Pymatic AskSage</b> integrates the AskSage.ai API directly into your JetBrains IDE,
        providing conversational AI assistance with user-selectable internet access modes and
        dynamic model selection.</p>

        <h3>Features</h3>
        <ul>
            <li><b>Live Mode Toggle</b> - Switch between No Live (offline), Live (web search), and Live+ (deep research) modes</li>
            <li><b>Model Selection</b> - Choose from all available AI models, dynamically fetched from AskSage</li>
            <li><b>Chat Interface</b> - Conversational AI chat directly in your IDE tool window</li>
            <li><b>Plugin Browser</b> - Browse and execute AskSage plugins with results rendered inline</li>
            <li><b>Agent Execution</b> - Run AskSage agents for complex multi-step tasks</li>
            <li><b>Knowledge Base Training</b> - Add code from the editor directly to your AskSage datasets</li>
            <li><b>Token Usage Dashboard</b> - Monitor monthly, daily, and remaining token usage</li>
            <li><b>Secure Authentication</b> - API key stored securely via IntelliJ PasswordSafe</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            factoryClass="org.jetbrains.plugins.template.ui.toolwindow.AskSageToolWindowFactory"
            id="AskSage"
            anchor="right"
            icon="/icons/asksage.svg"
        />

        <applicationConfigurable
            parentId="tools"
            instance="org.jetbrains.plugins.template.ui.settings.AskSageSettingsConfigurable"
            id="org.jetbrains.plugins.template.ui.settings.AskSageSettingsConfigurable"
            displayName="Pymatic AskSage"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.api.auth.AuthManager"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.AskSageSettingsState"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.ModelRegistryService"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.PersonaRegistryService"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.DatasetRegistryService"
        />

        <projectService
            serviceImplementation="org.jetbrains.plugins.template.services.ChatSessionService"
        />

        <projectService
            serviceImplementation="org.jetbrains.plugins.template.services.ProjectContextService"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.PromptTemplateService"
        />

        <statusBarWidgetFactory
            implementation="org.jetbrains.plugins.template.ui.statusbar.AskSageStatusBarWidgetFactory"
            id="AskSageStatus"
        />

        <notificationGroup
            id="AskSage Notifications"
            displayType="BALLOON"
        />
    </extensions>

    <actions>
        <group id="AskSage.EditorContextMenu" text="AskSage" popup="true"
               icon="/icons/asksage.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>

            <action id="AskSage.ExplainCode"
                    class="org.jetbrains.plugins.template.actions.ExplainCodeAction"
                    text="Explain Code"
                    description="Ask AskSage to explain the selected code or current file"
                    icon="/icons/chat.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt E"/>
            </action>

            <action id="AskSage.RefactorCode"
                    class="org.jetbrains.plugins.template.actions.RefactorCodeAction"
                    text="Refactor with AskSage"
                    description="Get refactoring suggestions from AskSage"
                    icon="/icons/chat.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R"/>
            </action>

            <action id="AskSage.GenerateDocs"
                    class="org.jetbrains.plugins.template.actions.GenerateDocsAction"
                    text="Generate Documentation"
                    description="Generate documentation for the selected code or current file"
                    icon="/icons/chat.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt D"/>
            </action>

            <action id="AskSage.AskAboutFile"
                    class="org.jetbrains.plugins.template.actions.AskAboutFileAction"
                    text="Ask About This File..."
                    description="Ask AskSage a question about the current file"
                    icon="/icons/chat.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt A"/>
            </action>

            <separator/>

            <action id="AskSage.SendSelection"
                    class="org.jetbrains.plugins.template.actions.SendSelectionToAskSageAction"
                    text="Send Selection to AskSage"
                    description="Send selected code to AskSage chat"
                    icon="/icons/chat.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt S"/>
            </action>

            <separator/>

            <action id="AskSage.AddToKnowledgeBase"
                    class="org.jetbrains.plugins.template.actions.AddToKnowledgeBaseAction"
                    text="Add to Knowledge Base"
                    description="Add selected code or current file to an AskSage dataset"
                    icon="/icons/plugin.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt K"/>
            </action>
        </group>
    </actions>
</idea-plugin>
