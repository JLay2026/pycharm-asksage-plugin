<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.jetbrains.plugins.template</id>
    <name>Pymatic AskSage</name>
    <vendor>BigBear.ai</vendor>
    <description><![CDATA[
        <p><b>Pymatic AskSage</b> integrates the AskSage.ai API directly into your JetBrains IDE,
        providing conversational AI assistance with user-selectable internet access modes and
        dynamic model selection.</p>

        <h3>Features</h3>
        <ul>
            <li><b>Live Mode Toggle</b> - Switch between No Live (offline), Live (web search), and Live+ (deep research) modes</li>
            <li><b>Model Selection</b> - Choose from all available AI models, dynamically fetched from AskSage</li>
            <li><b>Chat Interface</b> - Conversational AI chat directly in your IDE tool window</li>
            <li><b>Secure Authentication</b> - API key stored securely via IntelliJ PasswordSafe</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            factoryClass="org.jetbrains.plugins.template.ui.toolwindow.AskSageToolWindowFactory"
            id="AskSage"
            anchor="right"
            icon="AllIcons.Actions.Find"
        />

        <applicationConfigurable
            parentId="tools"
            instance="org.jetbrains.plugins.template.ui.settings.AskSageSettingsConfigurable"
            id="org.jetbrains.plugins.template.ui.settings.AskSageSettingsConfigurable"
            displayName="Pymatic AskSage"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.api.auth.AuthManager"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.AskSageSettingsState"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.ModelRegistryService"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.PersonaRegistryService"
        />

        <applicationService
            serviceImplementation="org.jetbrains.plugins.template.services.DatasetRegistryService"
        />

        <projectService
            serviceImplementation="org.jetbrains.plugins.template.services.ChatSessionService"
        />

        <statusBarWidgetFactory
            implementation="org.jetbrains.plugins.template.ui.statusbar.AskSageStatusBarWidgetFactory"
            id="AskSageStatus"
        />
    </extensions>
</idea-plugin>
